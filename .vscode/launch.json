{
    // 双击 F5 前先确认：
    //   1. 板子已上电（电池架开关打开），J-Link 已插好且驱动装好
    //   2. 选的是 "J-Link (auto)" 这一项（本项目用的就是 J-Link）
    //   3. executable 必须是 build/week4_work.elf —— 与 Makefile 里的 TARGET 一致
    //   4. 如果上一次调试异常退出，先在任务管理器里结束残留的 JLinkGDBServerCL.exe，
    //      它占着 50000 端口会锁住探针，导致下一次 F5 一直连不上
    "version": "0.2.0",

    "configurations": [

        // ============================================================
        // 1. J-Link —— 由 Cortex-Debug 自动拉起 GDB Server（推荐）
        // ============================================================
        {
            "name": "J-Link (auto)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/week4_work.elf",

            "request": "launch",
            "type": "cortex-debug",

            // 目标 MCU：RoboMaster C 板 = STM32F407IGH6
            "device": "STM32F407IG",

            "servertype": "jlink",
            "serverpath": "D:/STM32/jlink_tools/JLink_V956/JLinkGDBServerCL.exe",

            // C 板调试口是 SWD
            "interface": "swd",

            // 外设寄存器视图。若报 “找不到文件”，把这一行注释掉即可，不影响下载运行。
            "svdFile": "D:/STM32/vscode/STM32F407.svd",

            // 下载后停在 main()，之后按 F5/Ctrl+F5 继续运行
            "runToEntryPoint": "main",

            // 运行中实时查看变量（本项目主要看 rc_data / rx_event_cnt / last_size）
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },

            "debuggerArgs": [
                "-iex",
                "set debug-file-directory ${workspaceFolder}/.gdb-debug"
            ],

            // 必须与 tasks.json 里的 "label" 完全一致
            "preLaunchTask": "build task"
        },

        // ============================================================
        // 2. J-Link —— 手动先开 GDB Server 再连（自动那项连不上时用）
        //    先在终端执行：
        //      JLinkGDBServerCL.exe -device STM32F407IG -if SWD -speed 4000 -port 50000
        //    等到出现 "Waiting for GDB connection"，再按 F5
        // ============================================================
        {
            "name": "J-Link (manual)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/week4_work.elf",

            "request": "launch",
            "type": "cortex-debug",

            "device": "STM32F407IG",
            "servertype": "external",
            "gdbTarget": "127.0.0.1:50000",
            "svdFile": "D:/STM32/vscode/STM32F407.svd",
            "runToEntryPoint": "main",

            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },

            "debuggerArgs": [
                "-iex",
                "set debug-file-directory ${workspaceFolder}/.gdb-debug"
            ],

            "preLaunchTask": "build task"
        },

        // ============================================================
        // 3. ST-Link（备用，走 OpenOCD）
        // ============================================================
        {
            "name": "ST-Link",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/week4_work.elf",

            "request": "launch",
            "type": "cortex-debug",

            "device": "STM32F407IG",
            "svdFile": "D:/STM32/vscode/STM32F407.svd",

            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],

            "runToEntryPoint": "main",

            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },

            "debuggerArgs": [
                "-iex",
                "set debug-file-directory ${workspaceFolder}/.gdb-debug"
            ],

            "preLaunchTask": "build task"
        },

        // ============================================================
        // 4. DAPLink / CMSIS-DAP（备用，走 OpenOCD）
        // ============================================================
        {
            "name": "DAPLink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/week4_work.elf",

            "request": "launch",
            "type": "cortex-debug",

            "device": "STM32F407IG",
            "svdFile": "D:/STM32/vscode/STM32F407.svd",

            "servertype": "openocd",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],

            "runToEntryPoint": "main",

            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },

            "debuggerArgs": [
                "-iex",
                "set debug-file-directory ${workspaceFolder}/.gdb-debug"
            ],

            "preLaunchTask": "build task"
        }
    ]
}
